{
  "name": "dictation-radiology-nepal",
  "version": "0.1.0",
  "description": "Dictation tool for radiology residents using Electron and MedASR",
  "main": "public/main.js",
  "homepage": "./",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"public/**/*.{js,css,html}\" \"*.json\" \"*.md\"",
    "dev": "concurrently \"npm run start-react\" \"wait-on http://localhost:3000 && npm run start-electron\"",
    "start-react": "react-scripts start",
    "start-electron": "electron .",
    "build": "npm run prepare-model && npm run build-python && npm run build-react && npm run build-electron",
    "prepare-model": "python3.11 scripts/download_medasr_model.py",
    "build-react": "GENERATE_SOURCEMAP=false react-scripts build",
    "build-electron": "electron-builder --dir && npm run build-dmg",
    "build-dmg": "bash scripts/create_dmg.sh",
    "build-python": "python3.11 -m PyInstaller --noconfirm --workpath pyinstaller-build --onedir --collect-all transformers --collect-all tokenizers --collect-all safetensors --collect-all huggingface_hub --collect-all librosa --collect-binaries torch --distpath python-dist --name transcribe_realtime transcribe_realtime.py"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "ffmpeg-static": "5.3.0",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^8.0.0",
    "electron": "^41.2.0",
    "electron-builder": "26.8.1",
    "prettier": "^3.8.1",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.0.1",
    "webpack": "5.75.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.drnepal.dictation",
    "productName": "Dictation Tool",
    "files": [
      "build/**/*",
      "public/main.js",
      "public/preload.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/transcribe_realtime/",
        "to": "transcribe_realtime/"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "bin/ffmpeg"
      },
      {
        "from": "resources/medasr-model/",
        "to": "medasr-model/"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "identity": null,
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record and transcribe radiology dictations."
      }
    }
  }
}
